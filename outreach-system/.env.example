# --- Airtable (Free plan) ---
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Only needed once, to run scripts/setup_airtable_schema.py - not used at runtime.
AIRTABLE_WORKSPACE_ID=

# --- Google Places API (New) ---
# Google Cloud project with Places API (New) enabled, $200/month free credit
GOOGLE_MAPS_API_KEY=

# --- Meta WhatsApp Cloud API ---
# From Meta Business Manager > WhatsApp > API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=change_me_to_a_random_string

# --- Groq (AI personalization + reply classification) ---
GROQ_API_KEY=

# --- Email sending: pick ONE path ---
# Path A: Gmail API (OAuth) - preferred, needs Google Cloud OAuth client
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_ADDRESS=

# Path B: plain SMTP with a Gmail App Password (simpler to bootstrap)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Human handoff notifications ---
SLACK_WEBHOOK_URL=

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
